# Copy to .env.local. Use a dedicated database role, not postgres.
DATABASE_URL=postgresql://pantrychef_app:CHANGE_ME@127.0.0.1:5432/pantrychef_app
APP_ORIGIN=http://localhost:3000
# Setup only: administrator email and password (at least 10 characters).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
